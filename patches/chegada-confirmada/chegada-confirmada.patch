+   var jump:Boolean=Boolean(incoming.jump);
+   var dx:Number=target.x-current.x;
+   var direction:Number=dx<0 ? -1 : 1;
+   var desired:Number=Math.abs(Number(target.vx));
+   if(previous){
+    var span:Number=Math.abs(target.x-previous.x);
+    var progress:Number=span>0.5 ? Math.max(0,Math.min(1,1-Math.abs(dx)/span)) : 1;
+    desired=Math.abs(Number(previous.vx))*(1-progress)+desired*progress;
